# Public site URL (no trailing slash) — used for canonical URLs, OG tags, and JSON-LD
NEXT_PUBLIC_SITE_URL=https://kozmelj.si

# PostHog analytics, read in production builds only
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# dev.to API key, only for running `yarn crosspost` locally (CI uses the DEVTO_API_KEY secret)
DEVTO_API_KEY=
